# Trustbook settings for compose.yaml. Copy this file to `.env` (same folder as compose.yaml)
# and adjust the paths. Use full paths with forward slashes; `~` is NOT expanded.

# Where the images come from: ghcr.io/<GITHUB_OWNER>/trustbook
GITHUB_OWNER=ludwich

# Image tag: `latest`, a released phase (e.g. `phase-0`) or a release candidate (e.g. `phase-0-rc`).
TRUSTBOOK_IMAGE_TAG=latest

# Port for the web UI: http://localhost:8484
TRUSTBOOK_PORT=8484

# Your home folder. Mounted READ-ONLY; the "Link folder" picker browses inside it.
#   Windows:       TRUSTBOOK_BROWSE_ROOT=C:/Users/<name>
#   Linux:         TRUSTBOOK_BROWSE_ROOT=/home/<name>
#   macOS:         TRUSTBOOK_BROWSE_ROOT=/Users/<name>
TRUSTBOOK_BROWSE_ROOT=/home/<name>

# Trustbook's own data folder (spaces, settings, API keys). Mounted read-write.
# Created on first start if it does not exist.
#   Windows:       TRUSTBOOK_DATA=C:/Users/<name>/Trustbook
#   Linux:         TRUSTBOOK_DATA=/home/<name>/Trustbook
#   macOS:         TRUSTBOOK_DATA=/Users/<name>/Trustbook
TRUSTBOOK_DATA=/home/<name>/Trustbook
